# =============================================================================
# PR-Analysis Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM Inference Provider ---
# Supported: ollama (default, local), openai, anthropic, google, openrouter, local (vLLM)
LLM_PROVIDER=ollama
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=ollama/qwen2.5-coder:7b-instruct

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- API Server ---
API_PORT=8923
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:4096,http://localhost:3000

# --- GitHub Integration ---
# Required for crawling PR review comments
GITHUB_TOKEN=
# Optional: validates incoming webhook payloads (HMAC-SHA256)
GITHUB_WEBHOOK_SECRET=

# --- Security ---
# Fernet key for encrypting stored tokens (auto-generated if empty)
FERNET_KEY=
# Optional: Bearer token required for all API requests (leave empty to disable)
API_AUTH_TOKEN=

# --- Pipeline Tuning ---
DEDUP_DISTANCE_THRESHOLD=0.32
AUTO_APPROVE_CONFIDENCE=0.8
WEBHOOK_MIN_INTERVAL=60

# --- Data Directory ---
# DATA_DIR=./backend/data

# --- Web UI ---
NEXT_PUBLIC_API_URL=http://localhost:8923

# --- MCP Server ---
PR_DISTILLER_API_URL=http://localhost:8923
