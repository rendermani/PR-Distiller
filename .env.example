# =============================================================================
# PR-Distiller Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM Inference Provider ---
# Supported via LiteLLM: ollama (default), openai, anthropic, google, openrouter, vllm
LLM_PROVIDER=ollama

# LLM_API_BASE — where the backend sends inference requests.
# Default works on Mac / Windows / Linux with host Ollama (make up).
# Override only if you run Ollama in Docker or use a cloud provider.
LLM_API_BASE=http://host.docker.internal:11434/v1

LLM_API_KEY=
LLM_MODEL=ollama/qwen3:8b

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- API Server ---
API_PORT=8923
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:4096,http://localhost:3000

# --- GitHub Integration ---
# Required for crawling PR review comments
GITHUB_TOKEN=
# Optional: validates incoming webhook payloads (HMAC-SHA256)
GITHUB_WEBHOOK_SECRET=

# --- Security ---
# Fernet key for encrypting stored tokens (auto-generated if empty)
FERNET_KEY=
# Bearer token enforced on mutating endpoints. Leave empty for auto-generation:
# the backend creates a random token on first start and persists it to
# data/.api_token (chmod 600). The web-ui reads the same file via a read-only
# volume, so the token never appears in the browser bundle. Set this only if
# you want to pin a specific value.
API_AUTH_TOKEN=

# --- Pipeline Tuning ---
DEDUP_DISTANCE_THRESHOLD=0.32
AUTO_APPROVE_CONFIDENCE=0.8
WEBHOOK_MIN_INTERVAL=60

# --- Data Directory ---
# DATA_DIR=./backend/data

# --- Web UI ---
# The browser talks to a same-origin Next.js proxy at /api/proxy/*; no public
# URL or token is exposed in the client bundle. Set BACKEND_INTERNAL_URL only
# if you run the Next.js server outside Docker and need a non-default backend
# location.
# BACKEND_INTERNAL_URL=http://localhost:8923

# --- MCP Server ---
PR_DISTILLER_API_URL=http://localhost:8923

# --- HuggingFace ---
# Optional. Required for gated models; recommended to avoid rate limits.
# Get a token at https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=

# --- Webhook public URL ---
# The publicly reachable URL of your backend (where GitHub will POST webhooks).
# If unset, the Vault page falls back to the dashboard URL with a warning.
WEBHOOK_PUBLIC_URL=

# --- LLM Provider keys (optional env override; UI Vault is the alternative) ---
# When set here, the corresponding input on the /secrets page is shown disabled
# with a "from environment" badge — set in the Vault UI for runtime changes,
# or here if you're integrating with a secrets manager.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
